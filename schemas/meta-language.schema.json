{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meta-language",
  "title": "Meta Language Override Row",
  "description": "Validates a row in meta-language-{lang}.csv — localised title, description and link.",
  "type": "object",
  "required": ["id", "title", "link"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 9999
    },
    "link": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "additionalProperties": true
}
