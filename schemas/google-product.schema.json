{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "google-product",
  "title": "GoogleProduct",
  "description": "Google Merchant Center product payload schema",
  "type": "object",
  "required": ["id", "title", "link", "image_link", "availability", "price", "brand"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "maxLength": 150 },
    "description": { "type": "string", "maxLength": 5000 },
    "link": { "type": "string", "format": "uri" },
    "image_link": { "type": "string", "format": "uri" },
    "additional_image_link": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "lifestyle_image_link": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "availability": { "type": "string", "enum": ["in_stock", "out_of_stock", "preorder", "backorder"] },
    "availability_date": { "type": "string" },
    "price": { "type": "string", "pattern": "^\\d+\\.\\d{2} [A-Z]{3}$" },
    "sale_price": { "type": "string" },
    "sale_price_effective_date": { "type": "string" },
    "brand": { "type": "string" },
    "gtin": { "type": "string" },
    "mpn": { "type": "string" },
    "identifier_exists": { "type": "string", "enum": ["yes", "no"] },
    "condition": { "type": "string", "enum": ["new", "refurbished", "used"] },
    "google_product_category": { "type": "string" },
    "product_type": { "type": "string" },
    "item_group_id": { "type": "string" },
    "color": { "type": "string" },
    "material": { "type": "string" },
    "size": { "type": "string" },
    "shipping": { "type": "string" },
    "shipping_weight": { "type": "string" },
    "product_highlight": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
    "product_detail": { "type": "array" },
    "custom_label_0": { "type": "string" },
    "custom_label_1": { "type": "string" },
    "custom_label_2": { "type": "string" },
    "custom_label_3": { "type": "string" },
    "custom_label_4": { "type": "string" }
  }
}
