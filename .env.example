# ══════════════════════════════════════════════════════════════════════════════
# Homestorys Product Feed Engine — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env for local development (never commit .env to Git).
# In Replit, add these via the Secrets panel.
# In Replit Production Deployment, add them via deployment secrets.
#
# ── REQUIRED TO RUN ───────────────────────────────────────────────────────────

# Replit PostgreSQL database connection string (auto-provided by Replit DB)
DATABASE_URL=

# Internal API authentication secret (generate a strong random string)
INTERNAL_API_SECRET=

# Application environment: development | preview | production
APP_ENV=development

# ── SHOPIFY ───────────────────────────────────────────────────────────────────
# Create a custom app in your Shopify Partner Dashboard for the Homestorys store.
# Required scopes: read_products, read_inventory, read_locations,
#                  read_markets, read_translations, read_locales, read_publications
# Optional (bestseller scoring): read_orders

# Your Shopify store domain (e.g. homestorys.myshopify.com)
SHOPIFY_SHOP_DOMAIN=

# Admin API access token from your custom app
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify Admin API version to use (pin explicitly, e.g. 2025-01)
SHOPIFY_API_VERSION=2025-01

# Webhook HMAC secret — from your custom app's webhook settings
SHOPIFY_WEBHOOK_SECRET=

# Eupen showroom location ID — discovered automatically by audit:shopify script
# Override manually if auto-detection fails
SHOPIFY_EUPEN_LOCATION_ID=

# ── GOOGLE MERCHANT CENTER ────────────────────────────────────────────────────
# Docs: https://developers.google.com/merchant/api

# Your Google Merchant Center account ID (numeric)
GOOGLE_MERCHANT_ACCOUNT_ID=

# Google Service Account credentials (JSON key file, base64-encoded)
# base64 < service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Google Local Inventory store code for Eupen showroom
# Must match the store code in Google Merchant Center > Business Info > Stores
GOOGLE_EUPEN_STORE_CODE=

# Dry-run mode: true = generate payloads/snapshots without writing to Google
GOOGLE_DRY_RUN=true

# ── META CATALOG ──────────────────────────────────────────────────────────────
# Docs: https://developers.facebook.com/documentation/ads-commerce/catalog/

# Meta Business Suite Catalog ID
META_CATALOG_ID=

# System user access token with catalog permissions
META_ACCESS_TOKEN=

# Meta Business account ID
META_BUSINESS_ID=

# Dry-run mode: true = generate feed files without uploading to Meta
META_DRY_RUN=true

# ── REPLIT APP STORAGE ────────────────────────────────────────────────────────
# Object storage for feed snapshots and manifests.
# The bucket ID is typically auto-detected from the Replit environment.
# Set only if you need to override the default bucket.
APP_STORAGE_BUCKET_ID=

# ── ALERTING ──────────────────────────────────────────────────────────────────
# Optional webhook URL for alert notifications (e.g. Slack incoming webhook)
ALERT_WEBHOOK_URL=

# ── CONFIG OVERRIDE ───────────────────────────────────────────────────────────
# Override config directory (default: <workspace-root>/config/)
CONFIG_DIR=

# ── LOGGING ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ══════════════════════════════════════════════════════════════════════════════
# SETUP CHECKLIST (first run):
# ══════════════════════════════════════════════════════════════════════════════
# 1. Set DATABASE_URL (Replit PostgreSQL auto-provides this)
# 2. Set INTERNAL_API_SECRET (random string ≥ 32 chars)
# 3. Create Shopify custom app → set SHOPIFY_* variables
# 4. Run: pnpm --filter @workspace/scripts run bootstrap
# 5. Run: pnpm --filter @workspace/scripts run audit:shopify
# 6. Update config/stores.yaml with discovered Eupen location ID
# 7. Set Google / Meta credentials when ready for channel integration
# ══════════════════════════════════════════════════════════════════════════════
